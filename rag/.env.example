# Milvus 云端连接与知识库集合
MILVUS_CLOUD_URI=
MILVUS_CLOUD_TOKEN=
MILVUS_COLLECTION_NAME=openworkbot_knowledge_chunks

# 本地 Embedding 与重排服务
EMBEDDING_BASE_URL=http://127.0.0.1:11436
EMBEDDING_MODEL_PATH=
RERANKER_BASE_URL=http://127.0.0.1:11435
RERANKER_MODEL_PATH=

# 独立 RAG 的 OpenAI 模型
LLM_PROVIDER=openai
MODEL_ID=gpt-6-luna
# RAG OpenAI 推理强度：none / low / medium / high / xhigh / max。
RAG_REASONING_EFFORT=max
# RAG 文本生成温度：0–2，具体范围依接口；none 或留空不传。GPT-6 Luna 非 none 推理需不传温度。
RAG_TEMPERATURE=none
EVAL_MODEL_ID=gpt-6.1-terra
# 评测裁判推理强度；GPT-6 系列非 none 推理需不传温度。
EVAL_REASONING_EFFORT=medium
# 评测裁判温度：0–2；none 或留空不传。
EVAL_TEMPERATURE=none
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# 本地模型启动参数
LLAMA_DEVICE=
LLAMA_CONTEXT_SIZE=4096

# Langfuse Cloud 密钥与所在区域地址
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
