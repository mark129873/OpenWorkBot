# 复制为 backend/.env；勿覆盖已有配置。

# 模型接口
# anthropic 或 openai；现有配置不填写时默认为 anthropic。
LLM_PROVIDER=anthropic

# Anthropic 兼容 API 密钥
ANTHROPIC_API_KEY=sk-xxx

# 留空使用 Anthropic 默认地址。
ANTHROPIC_BASE_URL=

# 使用 OpenAI 时改为 LLM_PROVIDER=openai，并填写密钥；地址留空使用官方接口。
OPENAI_API_KEY=
OPENAI_BASE_URL=

# 填写接口支持的模型 ID。
# OpenAI 示例：MODEL_ID=gpt-6-luna
MODEL_ID=claude-sonnet-4-20250514

# 运行参数
# 单次回复最大 token 数
MAX_TOKENS=10000

# 命令超时，单位秒。
BASH_TIMEOUT=120

# 模型上下文窗口，单位 token。
CONTEXT_WINDOW=1000000

# 压缩阈值 = 窗口 - 输出预留 - 缓冲。
COMPACT_OUTPUT_RESERVE=32000

# 安全缓冲，单位 token。
COMPACT_BUFFER=13000

# 保留最近完整工具输出条数；旧输出替换为占位符。
MICROCOMPACT_KEEP=5

# 服务
# 无鉴权，仅监听本机。
HOST=127.0.0.1

# 与启动器、前端代理保持一致。
PORT=8100

# 数据库、工作区及日志；相对路径基于 backend/。
DATA_DIR=data

# 日志
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 可选模型快照配置
# 默认项目根 log/；显式相对路径基于 backend/。快照含正文，不入库。
# MODELIO_DIR=log

# 单文件轮转阈值，单位 MB。
# MODELIO_MAX_MB=10
