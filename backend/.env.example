# 复制为 backend/.env；勿覆盖已有配置。

# 模型接口
# 使用 OpenAI 兼容 Chat Completions；地址留空使用官方接口。
OPENAI_API_KEY=
OPENAI_BASE_URL=

# 填写接口支持的模型 ID。
# 示例：MODEL_ID=gpt-6-luna
MODEL_ID=

# 运行参数
# 单次回复最大 token 数
MAX_TOKENS=10000

# 容器命令超时及停止等待基准，单位秒；宿主命令始终关闭。
BASH_TIMEOUT=120

# 容器网络允许的域名，逗号分隔；留空表示无默认允许域名。修改后重启。
SANDBOX_ALLOW_DOMAINS=pypi.org,files.pythonhosted.org,registry.npmjs.org,github.com

# 模型上下文窗口，单位 token。
CONTEXT_WINDOW=1000000

# 压缩触发条件：输入 token、消息数、窗口比例任一达到阈值。
COMPACT_TRIGGER_TOKENS=800000
COMPACT_TRIGGER_MESSAGES=200
COMPACT_TRIGGER_FRACTION=0.8
COMPACT_KEEP_MESSAGES=20

# 工具文本结果超过阈值时落盘，返回首尾预览及路径。
TOOL_OUTPUT_THRESHOLD=12000
TOOL_OUTPUT_PREVIEW_HEAD=2000
TOOL_OUTPUT_PREVIEW_TAIL=1000

# 输出预留和安全缓冲同时约束最大输入。
COMPACT_OUTPUT_RESERVE=32000

# 安全缓冲，单位 token。
COMPACT_BUFFER=13000

# 服务
# 仅监听本机。
HOST=127.0.0.1

# 与启动器、前端代理保持一致。
PORT=8100

# 默认 SQLite；PostgreSQL 时业务表和检查点共用 DATABASE_URL。
DATABASE_BACKEND=sqlite
# 密码中的特殊字符需要 URL 编码。
# DATABASE_URL=postgresql://openworkbot:password@127.0.0.1:5432/openworkbot

# SQLite 数据库及长期记忆；相对路径基于 backend/。用户工作区固定在 backend/workspaces/。
DATA_DIR=data

# 日志
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 可选模型快照配置
# 默认项目根 log/；显式相对路径基于 backend/。快照含正文，不入库。
# MODELIO_DIR=log

# 单文件轮转阈值，单位 MB。
# MODELIO_MAX_MB=10
